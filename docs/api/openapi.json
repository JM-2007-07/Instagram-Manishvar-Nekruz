{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/username-availability": {
      "get": {
        "operationId": "AuthController_usernameAvailability",
        "parameters": [
          {
            "name": "userName",
            "required": true,
            "in": "query",
            "description": "1–30 символов: a–z, 0–9, «.», «_»",
            "schema": {
              "example": "ivan.petrov",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserNameAvailabilityDto"
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат имени"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Код отправлен письмом",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": ""
          },
          "409": {
            "description": "Имя пользователя или email заняты"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register/verify": {
      "post": {
        "operationId": "AuthController_verify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email подтверждён, cookie сессии установлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "400": {
            "description": "VERIFICATION_CODE_INVALID"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register/resend-code": {
      "post": {
        "operationId": "AuthController_resendCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Всегда 202, даже если email неизвестен"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cookie сессии установлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS"
          },
          "403": {
            "description": "EMAIL_NOT_VERIFIED или аккаунт заблокирован"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Сессия завершена, cookie удалена"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Всегда 202, даже если аккаунта нет"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "operationId": "AuthController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Пароль изменён, все сессии завершены"
          },
          "400": {
            "description": "Ссылка недействительна или слабый пароль"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/change": {
      "post": {
        "operationId": "AuthController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Пароль изменён, остальные сессии завершены"
          },
          "400": {
            "description": "Неверный текущий пароль или слабый новый"
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "operationId": "AuthController_listSessions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions/{sessionId}": {
      "delete": {
        "operationId": "AuthController_revokeSession",
        "parameters": [
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "Сессия не найдена или принадлежит другому пользователю"
          }
        },
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Photogram API",
    "description": "REST API /api/v1. Authentication: HttpOnly session cookie.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UserNameAvailabilityDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "suggestions": {
            "description": "До 3 свободных вариантов, если имя занято",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "available",
          "suggestions"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ivan@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          },
          "fullName": {
            "type": "string",
            "maxLength": 64
          },
          "userName": {
            "type": "string",
            "example": "ivan.petrov"
          },
          "birthday": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2000-01-31",
            "description": "YYYY-MM-DD, возраст не меньше 13 лет"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "userName",
          "birthday"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "codeSentAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "email",
          "codeSentAt"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "123456",
            "description": "6 цифр из письма"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "LinkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "url",
          "title"
        ]
      },
      "MutedDto": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "boolean"
          },
          "stories": {
            "type": "boolean"
          }
        },
        "required": [
          "posts",
          "stories"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "isVerified": {
            "type": "boolean"
          },
          "isPrivate": {
            "type": "boolean"
          },
          "hasActiveStory": {
            "type": "boolean",
            "description": "Есть активная история (кольцо вокруг аватара)"
          },
          "isCloseFriendStory": {
            "type": "boolean",
            "description": "Активная история только для близких друзей (зелёное кольцо)"
          }
        },
        "required": [
          "id",
          "userName",
          "fullName",
          "avatarUrl",
          "isVerified",
          "isPrivate",
          "hasActiveStory",
          "isCloseFriendStory"
        ]
      },
      "MutualFollowersDto": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSummaryDto"
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "users",
          "total"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "isVerified": {
            "type": "boolean"
          },
          "isPrivate": {
            "type": "boolean"
          },
          "hasActiveStory": {
            "type": "boolean",
            "description": "Есть активная история (кольцо вокруг аватара)"
          },
          "isCloseFriendStory": {
            "type": "boolean",
            "description": "Активная история только для близких друзей (зелёное кольцо)"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "pronouns": {
            "type": "string",
            "nullable": true
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LinkDto"
            }
          },
          "postCount": {
            "type": "number"
          },
          "followerCount": {
            "type": "number"
          },
          "followingCount": {
            "type": "number"
          },
          "followStatus": {
            "enum": [
              "NONE",
              "FOLLOWING",
              "REQUESTED"
            ],
            "type": "string"
          },
          "followsMe": {
            "type": "boolean"
          },
          "isBlocked": {
            "type": "boolean"
          },
          "isRestricted": {
            "type": "boolean"
          },
          "isMuted": {
            "$ref": "#/components/schemas/MutedDto"
          },
          "mutualFollowers": {
            "$ref": "#/components/schemas/MutualFollowersDto"
          },
          "canViewContent": {
            "type": "boolean"
          },
          "isMe": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "birthday": {
            "type": "string",
            "example": "2000-01-31",
            "description": "YYYY-MM-DD"
          },
          "gender": {
            "nullable": true,
            "enum": [
              "FEMALE",
              "MALE",
              "CUSTOM",
              "PREFER_NOT_TO_SAY"
            ],
            "type": "string"
          },
          "genderCustom": {
            "type": "string",
            "nullable": true
          },
          "hasPassword": {
            "type": "boolean",
            "description": "false у аккаунта только с соцвходом"
          },
          "role": {
            "enum": [
              "USER",
              "ADMIN"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "userName",
          "fullName",
          "avatarUrl",
          "isVerified",
          "isPrivate",
          "hasActiveStory",
          "isCloseFriendStory",
          "bio",
          "pronouns",
          "links",
          "postCount",
          "followerCount",
          "followingCount",
          "followStatus",
          "followsMe",
          "isBlocked",
          "isRestricted",
          "isMuted",
          "mutualFollowers",
          "canViewContent",
          "isMe",
          "email",
          "emailVerified",
          "birthday",
          "gender",
          "genderCustom",
          "hasPassword",
          "role"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 254,
            "description": "Имя пользователя или email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 254,
            "description": "Имя пользователя или email"
          }
        },
        "required": [
          "login"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "description": "Токен из ссылки в письме"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128,
            "description": "Не нужен, если у аккаунта ещё нет пароля (соцвход)"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "ipCity": {
            "type": "string",
            "description": "Город по IP; пока не определяется"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean",
            "description": "Это сессия, из которой сделан запрос"
          }
        },
        "required": [
          "id",
          "userAgent",
          "createdAt",
          "lastUsedAt",
          "isCurrent"
        ]
      }
    }
  }
}
