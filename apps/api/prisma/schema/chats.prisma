// Direct (владелец — Студент A): чаты, участники, сообщения, реакции.
// Note (заметки) добавится отдельной задачей.

enum ChatType {
  DIRECT
  GROUP
}

enum ChatRole {
  MEMBER
  ADMIN
}

enum ChatParticipantStatus {
  ACTIVE
  REQUEST // запрос на переписку: сообщение от того, на кого получатель не подписан
  LEFT // вышел из группы или удалён из неё
}

enum MessageType {
  TEXT
  MEDIA
  VOICE
  SHARE_POST
  SHARE_PROFILE
  SHARE_STORY
  STORY_REPLY
  STORY_REACTION
  CALL
  SYSTEM
}

model Chat {
  id            String   @id @default(uuid()) @db.Uuid
  type          ChatType
  title         String?
  avatarMediaId String?  @unique @db.Uuid
  createdById   String   @db.Uuid
  directKey     String?  @unique // для DIRECT: "меньший id:больший id" — один чат на пару
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  avatarMedia  MediaFile?        @relation("ChatAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([lastMessageAt, id])
  @@map("chats")
}

model ChatParticipant {
  chatId            String                @db.Uuid
  userId            String                @db.Uuid
  role              ChatRole              @default(MEMBER)
  status            ChatParticipantStatus @default(ACTIVE)
  joinedAt          DateTime              @default(now())
  lastReadMessageId String?               @db.Uuid
  lastReadAt        DateTime? // createdAt прочитанного сообщения: от него считаем непрочитанные
  mutedUntil        DateTime?
  clearedAt         DateTime? // «удалить чат у себя»: сообщения раньше не показываются
  hidden            Boolean               @default(false) // чат скрыт у участника до нового сообщения

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, status, hidden])
  @@map("chat_participants")
}

model Message {
  id           String      @id @default(uuid()) @db.Uuid
  chatId       String      @db.Uuid
  senderId     String?     @db.Uuid
  type         MessageType
  text         String?
  clientId     String? // id, созданный клиентом: повторная отправка не создаёт дубликат
  replyToId    String?     @db.Uuid
  sharedPostId String?     @db.Uuid
  sharedUserId String?     @db.Uuid
  storyId      String?     @db.Uuid
  callId       String?     @unique @db.Uuid
  systemData   Json?
  editedAt     DateTime?
  unsentAt     DateTime?
  createdAt    DateTime    @default(now())

  chat       Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User?             @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  sharedUser User?             @relation("MessageSharedUser", fields: [sharedUserId], references: [id], onDelete: SetNull)
  sharedPost Post?             @relation("MessageSharedPost", fields: [sharedPostId], references: [id], onDelete: SetNull)
  story      Story?            @relation("MessageStory", fields: [storyId], references: [id], onDelete: SetNull)
  call       Call?             @relation("MessageCall", fields: [callId], references: [id], onDelete: SetNull)
  replyTo    Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]         @relation("MessageReply")
  media      MessageMedia[]
  reactions  MessageReaction[]

  @@index([chatId, createdAt, id])
  @@index([chatId, senderId, clientId])
  @@map("messages")
}

model MessageMedia {
  messageId String @db.Uuid
  mediaId   String @unique @db.Uuid
  position  Int

  message Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([messageId, position])
  @@map("message_media")
}

model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reactions")
}
