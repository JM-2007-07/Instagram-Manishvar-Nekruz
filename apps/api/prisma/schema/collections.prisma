// Сохранённое и подборки (владелец — Студент A, T2.A3 / T4.A5). Всё видно только владельцу.

// Закладка: пост в «Сохранённом» пользователя.
model SavedPost {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation("SavedPostOwner", fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation("SavedPostTarget", fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

// Именованная подборка. coverPostId — выбранная обложка (без FK: если пост ушёл из подборки, берётся последний добавленный).
model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String
  coverPostId String?  @db.Uuid
  createdAt   DateTime @default(now())

  owner User             @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([ownerId, createdAt])
  @@map("collections")
}

// Пост в подборке. Пост всегда есть и в SavedPost владельца (сервис поддерживает это правило).
model CollectionItem {
  collectionId String   @db.Uuid
  postId       String   @db.Uuid
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post       Post       @relation("CollectionItemPost", fields: [postId], references: [id], onDelete: Cascade)

  @@id([collectionId, postId])
  @@index([collectionId, addedAt])
  @@map("collection_items")
}
