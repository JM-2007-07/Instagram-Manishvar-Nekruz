# Backend (NestJS) environment. Copy to apps/api/.env and fill in local values.
# NEVER commit the real .env file. Variables are validated at startup (src/config).

NODE_ENV=development
PORT=4000

# PostgreSQL (local install in development). Use your own local password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/instagram?schema=public
# Separate database for e2e tests (npm run test:e2e). Optional: if empty, the DB name in DATABASE_URL is replaced
# with "instagram_test". The name must end with "_test" - tests wipe tables.
# DATABASE_URL_TEST=

# Browser origin of the Next.js app. Used for the Origin (CSRF) check and CORS.
WEB_ORIGIN=http://localhost:3000

# Render (ADR 0020): public URL of the Next.js service; the API forwards all pages there.
# Empty in development (the browser opens Next.js directly).
# WEB_UPSTREAM_URL=
# How many proxies in front of the API to trust for X-Forwarded-For (rate limit by client IP).
# Empty = only a local proxy (development). On Render: true.
# TRUST_PROXY=

# Sessions (see docs/architecture/AUTHENTICATION.md)
# In production the cookie name is __Host-sid (requires HTTPS).
SESSION_COOKIE_NAME=sid
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
# log: emails (codes, reset links) are written to the API log; smtp: sent via SMTP_* below
MAIL_DRIVER=log
# production only: "true" allows MAIL_DRIVER=log (codes in the server log, e.g. on Render without SMTP)
# MAIL_LOG_IN_PRODUCTION=true

# Media storage: "local" in development, "s3" for Cloudflare R2 / Amazon S3 later
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Product name in emails (own brand, ADR 0012; final name — Q31)
APP_NAME=Instagram
MAIL_FROM=no-reply@example.com
# Only when MAIL_DRIVER=smtp. Port 465 = TLS, 587 = STARTTLS.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<your gmail>,
# SMTP_PASSWORD=<16-character app password>, MAIL_FROM=<the same gmail>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Social login (ADR 0014). Leave empty to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Calls (ADR 0015). STUN is public; TURN is needed in production (Q34).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=

# Media processing (ADR 0016). Install ffmpeg; set paths if not in PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Two-factor auth secret encryption (P2). 32+ random characters, generated locally.
TWO_FACTOR_ENCRYPTION_KEY=
