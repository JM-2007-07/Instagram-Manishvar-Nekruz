# Backend (NestJS) environment. Copy to apps/api/.env and fill in local values.
# NEVER commit the real .env file. Variables are validated at startup (src/config).

NODE_ENV=development
PORT=4000

# PostgreSQL (local install in development). Use your own local password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/instagram?schema=public

# Browser origin of the Next.js app. Used for the Origin (CSRF) check and CORS.
WEB_ORIGIN=http://localhost:3000

# Sessions (see docs/architecture/AUTHENTICATION.md)
# In production the cookie name is __Host-sid (requires HTTPS).
SESSION_COOKIE_NAME=sid
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
# development: the reset link is written to the API log instead of being emailed
MAIL_DRIVER=log

# Media storage: "local" in development, "s3" for Cloudflare R2 / Amazon S3 later
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
