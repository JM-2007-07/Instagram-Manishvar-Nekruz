# Frontend (Next.js) environment. Copy to apps/web/.env.local.
# NEVER commit real .env files.

# Server-only URL of the NestJS API. Used by:
#  - next.config rewrites (browser /api/* -> NestJS)
#  - Server Components (session check via serverFetch)
# Not exposed to the browser: the browser calls same-origin /api/v1/...
API_INTERNAL_URL=http://localhost:4000

# Public Socket.IO address (ADR 0013). In production: the site origin (reverse proxy routes /socket.io/).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Product name shown in the UI (own brand, ADR 0012; final name — Q31)
NEXT_PUBLIC_APP_NAME=Photogram
